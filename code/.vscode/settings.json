{
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.enhancedColorization": "enabled",
  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "variable": "#9CDCFE",
      "variable.global": "#4FC1FF",
      "variable.static": "#4FC1FF",
      "variable.readonly": "#4FC1FF",
      "property": "#9CDCFE",
      "parameter": "#9CDCFE",
      "macro": "#569CD6",
      "enumMember": "#4FC1FF"
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "variable.other.C",
          "variable.other.c",
          "variable.other.readwrite.c",
          "variable.other.member.c",
          "variable.other.property.c",
          "meta.Indexed-name.c"
        ],
        "settings": {
          "foreground": "#9CDCFE"
        }
      },
      {
        "scope": [
          "constant.other.c",
          "entity.name.constant.c"
        ],
        "settings": {
          "foreground": "#4FC1FF"
        }
      }
    ]
  },
  "C_Cpp.default.compilerPath": "",
  "C_Cpp.default.cStandard": "c99",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x86",
  "C_Cpp.default.defines": [
    "unSP=1",
    "__POINTER_32__=1",
    "__CHAR_16__=1",
    "GPCE500A=1"
  ],
  "C_Cpp.default.forcedInclude": [
    "${workspaceFolder}/Include/spinmaster.h"
  ],
  "C_Cpp.default.includePath": [
    "${workspaceFolder}",
    "${workspaceFolder}/Include",
    "${workspaceFolder}/project",
    "${workspaceFolder}/project/voice/FileMergerVersion1",
    "${workspaceFolder}/main",
    "${workspaceFolder}/hal",
    "${workspaceFolder}/bsp",
    "${workspaceFolder}/ram_heap",
    "${workspaceFolder}/audio",
    "${workspaceFolder}/dev/button",
    "${workspaceFolder}/dev/timer",
    "${workspaceFolder}/dev/lcd",
    "${workspaceFolder}/gui/geometry",
    "${workspaceFolder}/gui/font",
    "${workspaceFolder}/gui/icon",
    "${workspaceFolder}/gui/widget/button",
    "${workspaceFolder}/gui/widget/textbox",
    "${workspaceFolder}/gui/widget/label",
    "${workspaceFolder}/gui/widget/progressbar",
    "${workspaceFolder}/gui/widget/checkbox",
    "${workspaceFolder}/gui/widget/slider",
    "${workspaceFolder}/gui/widget/switch",
    "${workspaceFolder}/gui/desktop",
    "${workspaceFolder}/gui/game",
    "${workspaceFolder}/gui/game/snake",
    "${workspaceFolder}/gui/game/tetris",
    "${workspaceFolder}/gui/game/brick",
    "${workspaceFolder}/gui/game/flappy",
    "${workspaceFolder}/gui/game/shooter",
    "${workspaceFolder}/gui/game/g2048",
    "${workspaceFolder}/message",
    "${workspaceFolder}/schedule",
    "C:/Program Files (x86)/Generalplus/unSPIDE_4.1.1/library/include",
    "C:/Program Files (x86)/Generalplus/unSPIDE_4.1.1/library/include/sys"
  ],
  "C_Cpp.default.browse.path": [
    "${workspaceFolder}",
    "C:/Program Files (x86)/Generalplus/unSPIDE_4.1.1/library/include",
    "C:/Program Files (x86)/Generalplus/unSPIDE_4.1.1/library/include/sys"
  ],
  "files.exclude": {
    "**/Debug": true,
    "project/Device.env": true,
    "project/GP500_base.bdy": true,
    "project/GP500_base.env": true,
    "project/GP500_base.inb": true,
    "project/GP500_base.inbex": true,
    "project/GP500_base.opt": true,
    "project/GP500_base.rc": true,
    "project/GP500_base.set": true
  },
  "search.exclude": {
    "**/Debug": true,
    "project/Device.env": true,
    "project/GP500_base.bdy": true,
    "project/GP500_base.env": true,
    "project/GP500_base.inb": true,
    "project/GP500_base.inbex": true,
    "project/GP500_base.opt": true,
    "project/GP500_base.rc": true,
    "project/GP500_base.set": true
  }
}